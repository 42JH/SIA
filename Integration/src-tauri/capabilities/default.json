{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main SIA window: sidecar execution + native notifications",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/sia-backend", "sidecar": true },
        { "name": "binaries/sia-ai", "sidecar": true }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        { "name": "binaries/sia-backend", "sidecar": true },
        { "name": "binaries/sia-ai", "sidecar": true }
      ]
    }
  ]
}
