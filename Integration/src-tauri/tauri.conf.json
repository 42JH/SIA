{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sia-desktop",
  "version": "0.1.0",
  "identifier": "com.sia.desktop",
  "build": {
    "frontendDist": "../../Frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/sync-overlay.cjs && npm run dev --prefix ../Frontend",
    "beforeBuildCommand": "node scripts/sync-overlay.cjs && npm run build --prefix ../Frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SIA",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "SIA Overlay",
        "url": "overlay/index.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sia-backend",
      "binaries/sia-ai"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
